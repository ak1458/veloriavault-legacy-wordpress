# Copy to deploy/staging.env or deploy/production.env and fill in.
# These files are git-ignored. Never put passwords or private keys here:
# use an SSH key loaded in your ssh-agent (or ~/.ssh/config).

DEPLOY_HOST=example.hostinger-server.com
DEPLOY_PORT=65002
DEPLOY_USER=u000000000
# Absolute path of the WordPress root on the server (folder containing wp-config.php).
WP_PATH=/home/u000000000/domains/staging.example.com/public_html
# Public URL, used only for the post-deploy health check.
SITE_URL=https://staging.example.com
# staging | production
DEPLOY_TARGET=staging
# Optional private key path.
# SSH_KEY=~/.ssh/id_ed25519
